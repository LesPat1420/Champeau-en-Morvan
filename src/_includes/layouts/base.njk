<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} – {{ site.nom }}{% else %}{{ site.nomLong }} – Site officiel{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.nomLong }}">
  <meta property="og:title" content="{{ title or site.nomLong }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:locale" content="fr_FR">
  {% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% endif %}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='10' fill='%231b3a5c'/%3E%3Ctext x='32' y='44' font-size='38' text-anchor='middle' fill='%23fff' font-family='Georgia,serif'%3EC%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="Actualités – {{ site.nom }}" href="/actualites/flux.xml">
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu principal</a>

  {% include "partials/alerte.njk" %}
  {% include "partials/header.njk" %}

  <main id="contenu">
    {% block contenu %}{{ content | safe }}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
